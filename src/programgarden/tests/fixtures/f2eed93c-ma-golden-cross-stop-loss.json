{
  "id": "incident-f2eed93c-ma10-30-golden-cross-stop-8pct",
  "name": "10/30 이동평균 골든크로스 매수 + -8% 손절 (prod 대화 f2eed93c 재구성)",
  "description": "2026-08-28 prod 대화 f2eed93c 에서 끝내 저장되지 않은 자동매매의 모양을 재구성한 회귀 fixture. 원본 DSL 은 세션 스크래치패드와 함께 사라져 계획서 §2.3 의 기술(7종목 watchlist → symbols 전체 바인딩 historical → 골든크로스 → 미보유 필터 → sizing(symbols 전체 바인딩) → 매수, 계좌 positions → -8% 손절 → 매도)대로 복원했다.",
  "version": "1.0.0",
  "nodes": [
    {"id": "start", "type": "StartNode"},
    {"id": "broker", "type": "OverseasStockBrokerNode", "credential_id": "broker_cred"},
    {"id": "account", "type": "OverseasStockAccountNode"},
    {"id": "watchlist", "type": "WatchlistNode", "symbols": [
      {"symbol": "AAPL", "exchange": "NASDAQ"}, {"symbol": "MSFT", "exchange": "NASDAQ"},
      {"symbol": "NVDA", "exchange": "NASDAQ"}, {"symbol": "AMZN", "exchange": "NASDAQ"},
      {"symbol": "GOOGL", "exchange": "NASDAQ"}, {"symbol": "META", "exchange": "NASDAQ"},
      {"symbol": "TSLA", "exchange": "NASDAQ"}
    ]},
    {"id": "historical", "type": "OverseasStockHistoricalDataNode",
     "symbols": "{{ nodes.watchlist.symbols }}",
     "start_date": "{{ date.ago(90, format='yyyymmdd') }}",
     "end_date": "{{ date.today(format='yyyymmdd') }}",
     "interval": "1d"},
    {"id": "ma_cross", "type": "ConditionNode", "plugin": "MovingAverageCross",
     "items": {"from": "{{ item.time_series }}",
               "extract": {"symbol": "{{ item.symbol }}", "exchange": "{{ item.exchange }}",
                           "date": "{{ row.date }}", "close": "{{ row.close }}"}},
     "fields": {"short_period": 10, "long_period": 30, "cross_type": "golden"}},
    {"id": "buy_pick", "type": "SymbolFilterNode", "operation": "difference",
     "input_a": "{{ nodes.ma_cross.passed_symbols }}", "input_b": "{{ nodes.account.held_symbols }}"},
    {"id": "market", "type": "OverseasStockMarketDataNode", "symbol": "{{ item }}"},
    {"id": "sizing", "type": "PositionSizingNode",
     "symbols": "{{ nodes.buy_pick.symbols }}",
     "balance": "{{ nodes.account.balance.orderable_amount }}",
     "market_data": "{{ nodes.market.values }}",
     "method": "fixed_percent", "max_percent": 10.0},
    {"id": "buy_order", "type": "OverseasStockNewOrderNode",
     "side": "buy", "order_type": "limit", "order": "{{ item }}"},
    {"id": "stop_cond", "type": "ConditionNode", "plugin": "StopLoss",
     "positions": "{{ nodes.account.positions }}", "fields": {"stop_percent": -8.0}},
    {"id": "sell_order", "type": "OverseasStockNewOrderNode",
     "side": "sell", "order_type": "market",
     "order": {"symbol": "{{ item.symbol }}", "exchange": "{{ item.exchange }}", "quantity": "{{ item.quantity }}"}}
  ],
  "edges": [
    {"from": "start", "to": "broker"},
    {"from": "broker", "to": "account"},
    {"from": "broker", "to": "watchlist"},
    {"from": "watchlist", "to": "historical"},
    {"from": "historical", "to": "ma_cross"},
    {"from": "ma_cross", "to": "buy_pick"},
    {"from": "account", "to": "buy_pick"},
    {"from": "buy_pick", "to": "market"},
    {"from": "buy_pick", "to": "sizing"},
    {"from": "market", "to": "sizing"},
    {"from": "account", "to": "sizing"},
    {"from": "sizing.orders", "to": "buy_order"},
    {"from": "broker", "to": "buy_order"},
    {"from": "account", "to": "stop_cond"},
    {"from": "stop_cond.passed_symbols", "to": "sell_order"},
    {"from": "broker", "to": "sell_order"}
  ],
  "credentials": [
    {"credential_id": "broker_cred", "type": "broker_ls_overseas_stock",
     "data": [{"key": "appkey", "value": "", "type": "password", "label": "App Key"},
              {"key": "appsecret", "value": "", "type": "password", "label": "App Secret"}]}
  ]
}
